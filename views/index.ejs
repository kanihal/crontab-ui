<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crontab UI</title>
<script>
(function() {
  try {
    var stored = localStorage.getItem('cui-theme');
    var resolved = (stored === 'light' || stored === 'dark')
      ? stored
      : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-bs-theme', resolved);
  } catch (_e) {}
})();
</script>
<link href="css/bootstrap.min.css" rel="stylesheet">
<link href="css/bootstrap-icons.min.css" rel="stylesheet">
<link href="css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="css/custom.css" rel="stylesheet">
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>
<script src="js/dataTables.min.js"></script>
<script src="js/dataTables.bootstrap5.min.js"></script>
<script src="js/cronstrue.min.js"></script>
<script src="script.js"></script>
<script src="mailconfig.js"></script>
<script type="text/javascript">
	var crontabs = [];
	var routes = [];
	document.addEventListener('DOMContentLoaded', function() {
		var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
		tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
		crontabs = JSON.parse('<%- crontabs.replace(/\\\\/g, "\\\\\\\\").replace(/\\\"/g,"\\\\\"").replace(/\'/g,"\\\'").replace(/\\t/g, " ") %>');
		routes = JSON.parse('<%- routes %>');
		initializeTestRuns();
	});
</script>
</head>
<body>
<%- include('navbar.ejs') -%>
<div class="app-container">
	<div class="app-card">
		<div class="toolbar d-flex flex-wrap align-items-center gap-2">
			<a class="btn btn-sm btn-primary" onclick="newJob();"><i class="bi bi-plus-circle"></i> New Job</a>
			<div class="btn-group btn-group-sm" role="group">
				<a class="btn btn-outline-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Refresh from system crontab" onclick="refreshCrontab();"><i class="bi bi-arrow-clockwise"></i></a>
				<a class="btn btn-outline-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit global env vars" onclick="editGlobals();"><i class="bi bi-pencil-square"></i></a>
				<a class="btn btn-outline-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Preview crontab" onclick="previewCrontab();"><i class="bi bi-eye"></i></a>
			</div>
			<div class="btn-group btn-group-sm ms-auto" role="group">
				<a class="btn btn-outline-secondary" onclick="import_db()"><i class="bi bi-box-arrow-in-down"></i> Import</a>
				<a class="btn btn-outline-secondary" href="<%= JSON.parse(routes).export %>"><i class="bi bi-box-arrow-up"></i> Export</a>
			</div>
		</div>
	</div>

	<div class="alert alert-info d-none test-run-banner" id="test-run-banner" role="status" aria-live="polite">
		<div class="d-flex flex-wrap align-items-center gap-2">
			<span class="test-run-indicator" id="test-run-banner-indicator"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span></span>
			<div class="flex-grow-1">
				<strong id="test-run-banner-title">Test Run</strong>
				<span id="test-run-banner-status">Starting…</span>
				<span class="text-muted ms-1" id="test-run-banner-elapsed"></span>
			</div>
			<button type="button" class="btn btn-sm btn-outline-primary" onclick="viewTestRunResult();"><i class="bi bi-terminal"></i> View</button>
			<button type="button" class="btn btn-sm btn-outline-danger" id="test-run-banner-stop" onclick="stopCurrentTestRun();"><i class="bi bi-stop-circle"></i> Stop</button>
			<button type="button" class="btn-close d-none" id="test-run-banner-dismiss" aria-label="Dismiss" onclick="dismissTestRun();"></button>
		</div>
	</div>

	<div class="app-card">
	<table class="table table-striped" id="main_table">
		<thead>
	<tr>
		<th class="col-num">#</th>
		<th>Name</th>
		<th>Job</th>
		<th>Time</th>
		<th class="col-modified">Last Modified</th>
		<th class="col-actions">Actions</th>
	</tr>
</thead>
<tbody>
	<% var index = 1 %>
		<% JSON.parse(crontabs).forEach(function(crontab){ %>
			<% if (!crontab.stopped) { %>
				<tr data-job-id="<%= crontab._id %>">
			<% } else { %>
				<tr class="table-primary" data-job-id="<%= crontab._id %>">
		<% } %>
				<td class="col-num">
					<%= index %>
					<% index += 1 %>
				</td>

				<td>
					<% if (crontab.name) { %>
						<%= crontab.name %>
						<a class="btn btn-sm" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= crontab._id %>"><i class="bi bi-info-circle"></i></a>
						<% } else { %>
							<%= crontab._id %>
						<% } %>
						<span class="job-test-run-indicator d-none ms-1 text-info" title="Test run in progress">
							<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
							<span class="visually-hidden">Test run in progress</span>
						</span>
					</td>
				<td><%= crontab.command %></td>
				<td>
					<span style="cursor:pointer" data-bs-toggle="tooltip" data-bs-placement="bottom" title="<%= crontab.next %>">
							<%= crontab.schedule %>
					</span>
					<a class="btn btn-sm" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= crontab.human %>">
						<i class="bi bi-info-circle"></i>
					</a>
				</td>
				<td class="col-modified" title="<%= crontab.timestamp %>"><%= dayjs(new Date(crontab.timestamp)).fromNow() %></td>
				<td class="nowrap-actions">

		<% if (!crontab.stopped) { %>
					<a class="btn btn-sm btn-link toggle-btn toggle-on" data-bs-toggle="tooltip" data-bs-placement="top" title="Disable" onclick="stopJob('<%= crontab._id %>', this)"><i class="bi bi-toggle-on"></i></a>
		<% } else { %>
					<a class="btn btn-sm btn-link toggle-btn toggle-off" data-bs-toggle="tooltip" data-bs-placement="top" title="Enable" onclick="startJob('<%= crontab._id %>', this)"><i class="bi bi-toggle-off"></i></a>
		<% } %>
					<button type="button" class="btn btn-sm btn-outline-success action-btn job-run-now" data-job-id="<%= crontab._id %>" data-bs-toggle="tooltip" data-bs-placement="top" title="Run now" onclick="runJob('<%= crontab._id %>', this)"><i class="bi bi-play-fill"></i><span class="visually-hidden">Run now</span></button>
					<a class="btn btn-sm btn-outline-primary action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit" onclick="editJob('<%= crontab._id %>')"><i class="bi bi-pencil-square"></i></a>
					<div class="btn-group btn-group-sm log-action-group" role="group" aria-label="Job logs">
		<% if (crontab.logging && crontab.logging != "false") { %>
						<a class="btn btn-outline-danger log-stderr" data-bs-toggle="tooltip" data-bs-placement="top" title="Error log (stderr)" href="<%= JSON.parse(routes).logger + '?id=' + crontab._id %>" target="_blank" rel="noopener"><i class="bi bi-exclamation-octagon"></i><span class="visually-hidden">Error log</span></a>
						<a class="btn btn-outline-info log-stdout" data-bs-toggle="tooltip" data-bs-placement="top" title="Output log (stdout)" href="<%= JSON.parse(routes).stdout + '?id=' + crontab._id %>" target="_blank" rel="noopener"><i class="bi bi-terminal"></i><span class="visually-hidden">Output log</span></a>
		<% } else { %>
						<button type="button" class="btn btn-outline-danger" data-bs-toggle="tooltip" data-bs-placement="top" title="Error log (stderr) unavailable — enable error logging" disabled><i class="bi bi-exclamation-octagon"></i><span class="visually-hidden">Error log unavailable</span></button>
						<button type="button" class="btn btn-outline-info" data-bs-toggle="tooltip" data-bs-placement="top" title="Output log (stdout) unavailable — enable error logging" disabled><i class="bi bi-terminal"></i><span class="visually-hidden">Output log unavailable</span></button>
		<% } %>
						<button type="button" class="btn btn-outline-warning job-last-test-run" data-bs-toggle="tooltip" data-bs-placement="top" data-last-test-run-id="<%= crontab.lastTestRun ? crontab.lastTestRun.id : '' %>" title="<%= crontab.lastTestRun ? 'Last test run' : 'No test run yet' %>" onclick="viewLastTestRun('<%= crontab._id %>', this)" <% if (!crontab.lastTestRun) { %>disabled<% } %>><i class="bi bi-clock-history"></i><span class="visually-hidden">Last test run</span></button>
					</div>
					<a class="btn btn-sm btn-outline-secondary action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="Duplicate" onclick="duplicateJob('<%= crontab._id %>')"><i class="bi bi-copy"></i></a>
					<a class="btn btn-sm btn-outline-danger action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete" onclick="deleteJob('<%= crontab._id %>')"><i class="bi bi-trash"></i></a>
				</td>
			</tr>
	<% }); %>


</tbody>
	</table>
	</div>
</div>
<%- include('popup.ejs') -%>
<script>
   document.addEventListener('DOMContentLoaded', function() {
   	$('#main_table').DataTable({
   		order: [[1, 'asc']],
   		pageLength: 50,
   		lengthMenu: [10, 25, 50, 100],
   		columns: [
   			{orderable: false},
   			null,
   			null,
   			null,
   			{orderable: false},
   			{orderable: false}
   		],
        	stateSave: true,
        	stateDuration: 0
  	});
   });
 </script>
</body>
</html>
