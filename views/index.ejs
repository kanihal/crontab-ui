<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crontab UI</title>
<script>
(function() {
  try {
    var stored = localStorage.getItem('cui-theme');
    var resolved = (stored === 'light' || stored === 'dark')
      ? stored
      : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-bs-theme', resolved);
  } catch (_e) {}
})();
</script>
<link href="css/bootstrap.min.css" rel="stylesheet">
<link href="css/bootstrap-icons.min.css" rel="stylesheet">
<link href="css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="css/custom.css" rel="stylesheet">
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>
<script src="js/dataTables.min.js"></script>
<script src="js/dataTables.bootstrap5.min.js"></script>
<script src="js/cronstrue.min.js"></script>
<script src="script.js"></script>
<script src="mailconfig.js"></script>
<script type="text/javascript">
	var crontabs = [];
	var routes = [];
	document.addEventListener('DOMContentLoaded', function() {
		var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
		tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
		crontabs = JSON.parse('<%- crontabs.replace(/\\\\/g, "\\\\\\\\").replace(/\\\"/g,"\\\\\"").replace(/\'/g,"\\\'").replace(/\\t/g, " ") %>');
		routes = JSON.parse('<%- routes %>');
	});
</script>
</head>
<body>
<%- include('navbar.ejs') -%>
<div class="app-container">
	<div class="app-card">
		<div class="toolbar d-flex flex-wrap align-items-center gap-2">
			<a class="btn btn-sm btn-primary" onclick="newJob();"><i class="bi bi-plus-circle"></i> New Job</a>
			<div class="btn-group btn-group-sm" role="group">
				<a class="btn btn-outline-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Refresh from system crontab" onclick="refreshCrontab();"><i class="bi bi-arrow-clockwise"></i></a>
				<a class="btn btn-outline-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit global env vars" onclick="editGlobals();"><i class="bi bi-pencil-square"></i></a>
				<a class="btn btn-outline-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="Preview crontab" onclick="previewCrontab();"><i class="bi bi-eye"></i></a>
			</div>
			<div class="btn-group btn-group-sm ms-auto" role="group">
				<a class="btn btn-outline-secondary" onclick="import_db()"><i class="bi bi-box-arrow-in-down"></i> Import</a>
				<a class="btn btn-outline-secondary" href="<%= JSON.parse(routes).export %>"><i class="bi bi-box-arrow-up"></i> Export</a>
			</div>
		</div>
	</div>

	<div class="app-card">
	<table class="table table-striped" id="main_table">
		<thead>
	<tr>
		<th class="col-num">#</th>
		<th>Name</th>
		<th>Job</th>
		<th>Time</th>
		<th class="col-modified">Last Modified</th>
		<th class="col-actions">Actions</th>
	</tr>
</thead>
<tbody>
	<% var index = 1 %>
	<% JSON.parse(crontabs).forEach(function(crontab){ %>
		<% if (!crontab.stopped) { %>
			<tr>
		<% } else { %>
			<tr class="table-primary">
		<% } %>
				<td class="col-num">
					<%= index %>
					<% index += 1 %>
				</td>

				<td>
					<% if (crontab.name) { %>
						<%= crontab.name %>
						<a class="btn btn-sm" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= crontab._id %>"><i class="bi bi-info-circle"></i></a>
					<% } else { %>
						<%= crontab._id %>
					<% } %>
				</td>
				<td><%= crontab.command %></td>
				<td>
					<span style="cursor:pointer" data-bs-toggle="tooltip" data-bs-placement="bottom" title="<%= crontab.next %>">
							<%= crontab.schedule %>
					</span>
					<a class="btn btn-sm" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= crontab.human %>">
						<i class="bi bi-info-circle"></i>
					</a>
				</td>
				<td class="col-modified" title="<%= crontab.timestamp %>"><%= dayjs(new Date(crontab.timestamp)).fromNow() %></td>
				<td class="nowrap-actions">

		<% if (!crontab.stopped) { %>
					<a class="btn btn-sm btn-link toggle-btn toggle-on" data-bs-toggle="tooltip" data-bs-placement="top" title="Disable" onclick="stopJob('<%= crontab._id %>', this)"><i class="bi bi-toggle-on"></i></a>
		<% } else { %>
					<a class="btn btn-sm btn-link toggle-btn toggle-off" data-bs-toggle="tooltip" data-bs-placement="top" title="Enable" onclick="startJob('<%= crontab._id %>', this)"><i class="bi bi-toggle-off"></i></a>
		<% } %>
					<a class="btn btn-sm btn-outline-success action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="Run now" onclick="runJob('<%= crontab._id %>')"><i class="bi bi-play-fill"></i></a>
					<a class="btn btn-sm btn-outline-primary action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="Edit" onclick="editJob('<%= crontab._id %>')"><i class="bi bi-pencil-square"></i></a>
		<% if (crontab.logging && crontab.logging != "false") { %>
					<a class="btn btn-sm btn-outline-danger action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="stderr log" href="<%= JSON.parse(routes).logger + '?id=' + crontab._id %>" target="_blank"><i class="bi bi-journal-x"></i></a>
					<a class="btn btn-sm btn-outline-primary action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="stdout log" href="<%= JSON.parse(routes).stdout + '?id=' + crontab._id %>" target="_blank"><i class="bi bi-journal-text"></i></a>
		<% } %>
					<a class="btn btn-sm btn-outline-secondary action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="Duplicate" onclick="duplicateJob('<%= crontab._id %>')"><i class="bi bi-copy"></i></a>
					<a class="btn btn-sm btn-outline-danger action-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete" onclick="deleteJob('<%= crontab._id %>')"><i class="bi bi-trash"></i></a>
				</td>
			</tr>
	<% }); %>


</tbody>
	</table>
	</div>
</div>
<%- include('popup.ejs') -%>
<script>
   document.addEventListener('DOMContentLoaded', function() {
   	$('#main_table').DataTable({
   		order: [[1, 'asc']],
   		pageLength: 50,
   		lengthMenu: [10, 25, 50, 100],
   		columns: [
   			{orderable: false},
   			null,
   			null,
   			null,
   			{orderable: false},
   			{orderable: false}
   		],
        	stateSave: true,
        	stateDuration: 0
  	});
   });
 </script>
</body>
</html>
