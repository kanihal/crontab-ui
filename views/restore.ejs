<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crontab UI</title>
<script>
(function() {
  try {
    var stored = localStorage.getItem('cui-theme');
    var resolved = (stored === 'light' || stored === 'dark')
      ? stored
      : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.setAttribute('data-bs-theme', resolved);
  } catch (_e) {}
})();
</script>
<link href="css/bootstrap.min.css" rel="stylesheet">
<link href="css/bootstrap-icons.min.css" rel="stylesheet">
<link href="css/custom.css" rel="stylesheet">
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>
<script src="script.js"></script>
<script type="text/javascript">
	var crontabs = [];
	var routes = [];
	document.addEventListener('DOMContentLoaded', function() {
		var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
		tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
		crontabs = JSON.parse('<%- crontabs.replace(/\\\\/g, "\\\\\\\\").replace(/\\\"/g,"\\\\\"").replace(/\'/g,"\\\'") %>');
		routes = JSON.parse('<%- routes %>');
	});
</script>
</head>
<body>
<%- include('navbar.ejs') -%>
<div class="app-container">
	<div class="page-header">
		<div class="d-flex align-items-center gap-2">
			<a class="btn btn-sm btn-outline-secondary" href="<%= back %>" title="Back"><i class="bi bi-arrow-left"></i> Back</a>
			<h2 class="mb-0"><%= db %></h2>
		</div>
	</div>
	<div class="app-card">
	<table class="table">
	<tr>
		<th>Id</th>
		<th></th>
		<th>Job</th>
		<th>Time</th>
		<th>Last Modified</th>
	</tr>
	<% var index = 1 %>
	<% JSON.parse(crontabs).forEach(function(crontab){ %>
		<% if (!crontab.stopped) { %>
			<tr>
		<% } else { %>
			<tr class="table-primary">
		<% } %>

				<td>
					<%= index %>.
					<% index += 1 %>
					<%= crontab._id %>
				</td>

				<td>
					<% if (crontab.name) { %>
					<a class="btn btn-sm" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= crontab.name %>"><i class="bi bi-info-circle"></i></a>
					<% } %>
				</td>
				<td><%= crontab.command %></td>
				<td><%= crontab.schedule %></td>
				<td><%= crontab.timestamp %></td>
			</tr>
	<% }); %>



	</table>
	</div>
	<div class="d-flex gap-2">
		<a class="btn btn-primary" onclick="restore_backup('<%= db %>')"><i class="bi bi-arrow-counterclockwise"></i> Restore</a>
		<a class="btn btn-danger" onclick="delete_backup('<%= db %>')"><i class="bi bi-trash"></i> Delete</a>
	</div>
</div>
<%- include('popup.ejs') -%>
</body>
</html>
