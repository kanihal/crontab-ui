<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="app-container">
    <a class="navbar-brand" href="<%= JSON.parse(routes).root %>">Crontab UI</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <li class="nav-item">
          <a class="nav-link nav-link-bordered" href="#" role="button" onclick="doBackup(); return false;" title="Create a backup of the cron database"><i class="bi bi-archive me-1"></i>Backup</a>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Backups</a>
          <ul class="dropdown-menu dropdown-menu-lg-end">
            <% if (backups.length == 0){ %>
              <li><a class="dropdown-item" href="#">None</a></li>
            <% } else { %>
              <% backups.slice(0, 3).forEach(function(file){ %>
                <li><a class="dropdown-item" href="<%= JSON.parse(routes).restore %>?db=<%= file %>"><%= file.replace(/^backup /, '').replace(/\.db$/, '') %></a></li>
              <% }) %>
              <% if (backups.length > 3) { %>
                <li><hr class="dropdown-divider"></li>
              <% } %>
              <li><a class="dropdown-item" href="<%= JSON.parse(routes).backups %>"><i class="bi bi-three-dots me-1"></i>More… (<%= backups.length %>)</a></li>
            <% } %>
          </ul>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link" href="#" role="button" id="theme-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Theme">
            <i class="bi bi-circle-half" id="theme-icon" style="font-size:1.1rem;"></i>
          </a>
          <ul class="dropdown-menu dropdown-menu-lg-end" aria-labelledby="theme-toggle">
            <li><a class="dropdown-item" href="#" onclick="setTheme('light'); return false;"><i class="bi bi-sun-fill me-2"></i>Light</a></li>
            <li><a class="dropdown-item" href="#" onclick="setTheme('dark'); return false;"><i class="bi bi-moon-fill me-2"></i>Dark</a></li>
            <li><a class="dropdown-item" href="#" onclick="setTheme('system'); return false;"><i class="bi bi-circle-half me-2"></i>System</a></li>
          </ul>
        </li>
        <li class="nav-item"><a class="nav-link" href="https://github.com/alseambusher/crontab-ui" target="_blank" rel="noopener" aria-label="GitHub repository" title="View on GitHub"><i class="bi bi-github" style="font-size:1.25rem;"></i></a></li>
      </ul>
    </div>
  </div>
</nav>
