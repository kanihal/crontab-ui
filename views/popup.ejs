<!-- Job -->
<div class="modal fade" id="job" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h5 class="modal-title" id="job-title">Job</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="job-body">
	<input type="hidden" id="job-version" value=""/>
	<div class="mb-2">
		<label class="form-label" for="job-name">Name (Optional)</label>
		<input type='text' class='form-control form-control-sm' id='job-name'/>
	</div>
	<div class="mb-2">
		<label class="form-label d-block">Job input</label>
		<div class="btn-group btn-group-sm job-mode-switch" role="group" aria-label="Job input mode">
			<input type="radio" class="btn-check" name="job-input-mode" id="job-mode-command" autocomplete="off" checked onchange="setJobInputMode('command');">
			<label class="btn btn-outline-secondary" for="job-mode-command"><i class="bi bi-terminal"></i> Command</label>
			<input type="radio" class="btn-check" name="job-input-mode" id="job-mode-code" autocomplete="off" onchange="setJobInputMode('code');">
			<label class="btn btn-outline-secondary" for="job-mode-code"><i class="bi bi-file-earmark-code"></i> Code</label>
		</div>
	</div>
	<div class="mb-2" id="job-command-panel">
		<label class="form-label" for="job-command">Command</label>
		<textarea class='form-control form-control-sm' id='job-command' rows='2' oninput="job_command = $(this).val(); job_string();"></textarea>
	</div>
	<div class="mb-2 job-code-panel" id="job-code-panel" style="display:none;">
		<div class="row g-2 align-items-end mb-2">
			<div class="col-sm-5">
				<label class="form-label" for="job-code-filename">File name</label>
				<input type="text" class="form-control form-control-sm" id="job-code-filename" placeholder="backup.sh" oninput="job_string();">
			</div>
			<div class="col-sm-7">
				<label class="form-label" for="job-code-file">Upload file</label>
				<input type="file" class="form-control form-control-sm" id="job-code-file" accept=".sh,.bash,.py,.js,.mjs,.cjs,text/plain" onchange="loadCodeFile(this);">
			</div>
		</div>
		<label class="form-label" for="job-code-content">Paste code</label>
		<textarea class="form-control form-control-sm font-monospace" id="job-code-content" rows="5" spellcheck="false" placeholder="#!/usr/bin/env bash&#10;echo hello" oninput="markCodeSource('paste'); job_string();"></textarea>
		<div class="d-flex flex-wrap align-items-center gap-2 mt-1">
			<span class="form-text small m-0" id="job-code-status">Use .sh, .bash, .py, .js, .mjs, or .cjs. Max 1 MiB.</span>
			<span class="badge text-bg-secondary" id="job-code-current" style="display:none;"></span>
		</div>
	</div>
	<label class="form-label">Quick Schedule</label>
	<div class="d-flex flex-wrap gap-3 mb-2">
		<a class="btn btn-outline-primary btn-sm" style="white-space:nowrap;" onclick="quick_schedule('* * * * *');">Minutely</a>
		<a class="btn btn-outline-primary btn-sm" style="white-space:nowrap;" onclick="quick_schedule('@hourly');">Hourly</a>
		<a class="btn btn-outline-primary btn-sm" style="white-space:nowrap;" onclick="quick_schedule('@daily');">Daily</a>
		<a class="btn btn-outline-primary btn-sm" style="white-space:nowrap;" onclick="quick_schedule('@monthly');">Monthly</a>
		<a class="btn btn-outline-primary btn-sm" style="white-space:nowrap;" onclick="quick_schedule('@weekly');">Weekly</a>
		<a class="btn btn-outline-primary btn-sm" style="white-space:nowrap;" onclick="quick_schedule('@yearly');">Yearly</a>
		<a class="btn btn-outline-primary btn-sm" style="white-space:nowrap;" onclick="quick_schedule('@reboot');">Startup</a>
	</div>

	<div class="d-flex align-items-end gap-3 mb-2">
		<div style="width:64px;"><label class="form-label small mb-1">Minute</label><input type="text" class="form-control form-control-sm text-center cron-field" id="job-minute" value="*" onclick="this.select();"/></div>
		<div style="width:64px;"><label class="form-label small mb-1">Hour</label><input type="text" class="form-control form-control-sm text-center cron-field" id="job-hour" value="*" onclick="this.select();"/></div>
		<div style="width:64px;"><label class="form-label small mb-1">Day</label><input type="text" class="form-control form-control-sm text-center cron-field" id="job-day" value="*" onclick="this.select();"/></div>
		<div style="width:64px;"><label class="form-label small mb-1">Month</label><input type="text" class="form-control form-control-sm text-center cron-field" id="job-month" value="*" onclick="this.select();"/></div>
		<div style="width:64px;"><label class="form-label small mb-1">Week</label><input type="text" class="form-control form-control-sm text-center cron-field" id="job-week" value="*" onclick="this.select();"/></div>
		<a class="btn btn-primary btn-sm" onclick="set_schedule();">Set</a>
		<input type="text" class="form-control form-control-sm flex-grow-1" id="job-human" readonly placeholder="Schedule preview" title="Human-readable schedule" style="min-width:0;"/>
	</div>

	<div class="mb-2">
		<label class="form-label" for="job-string">Job</label>
		<input type='text' class='form-control form-control-sm' id='job-string' disabled='disabled'/>
	</div>
	<div class="mb-2">
		<label class="form-label" for="job-env-vars">
			Environment Variables (Optional)
			<a tabindex="0" role="button" class="text-muted ms-1" data-bs-toggle="tooltip" data-bs-placement="right" data-bs-html="true" title="One variable per line, e.g. <code>PATH=/usr/local/bin:/usr/bin</code>. Prepended to this job's command at deploy and Test Run."><i class="bi bi-info-circle"></i></a>
		</label>
		<textarea class="form-control form-control-sm" rows="2" id="job-env-vars" placeholder="# PATH=/usr/local/bin:/usr/bin&#10;# MAILTO=you@example.com"></textarea>
	</div>
	<div class="mb-2">
		<button type="button" class="btn btn-outline-info btn-sm" id="job-test-run" onclick="testRunJob();"><i class="bi bi-play-circle"></i> Test Run</button>
		<div class="mt-2" id="job-test-result-wrap" style="display:none;">
			<label class="form-label small mb-1"><span id="job-test-result-title">Test Run Result</span> <span class="text-muted" id="job-test-status"></span></label>
			<pre id="job-test-result" class="bg-dark text-light p-2 rounded small mb-0" style="white-space:pre-wrap;word-break:break-all;"></pre>
		</div>
	</div>
	<div class="d-flex flex-wrap align-items-center gap-3">
		<div class="form-check m-0">
			<input type="checkbox" class="form-check-input" id="job-logging"/>
			<label class="form-check-label" for="job-logging">Enable error logging</label>
		</div>
		<a class="btn btn-outline-secondary btn-sm" data-json="{}" onclick="setMailConfig(this);" id="job-mailing"><i class="bi bi-envelope"></i> Mailing</a>
		<a class="btn btn-outline-secondary btn-sm" data-json="{}" onclick="setHookConfig(this);"><i class="bi bi-hdd-network"></i> Hooks</a>
	</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="job-save">Save</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="popup" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-title">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="modal-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="modal-close-button">Close</button>
        <button type="button" class="btn btn-primary" id="modal-button">Ok</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="info-popup" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="info-title">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="info-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="info-button">Ok</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="test-run-result-modal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-terminal"></i> <span id="test-run-modal-title">Test Run Result</span> <span class="text-muted small" id="test-run-modal-status"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <pre id="test-run-modal-output" class="bg-dark text-light p-3 rounded mb-0 test-run-output"></pre>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-danger" id="test-run-modal-stop" onclick="stopCurrentTestRun();"><i class="bi bi-stop-circle"></i> Stop</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="preview-crontab-modal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-code-square"></i> Crontab Preview</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info mb-3"><i class="bi bi-info-circle"></i> This is the crontab content currently deployed from your saved jobs and env vars.</div>
        <pre id="preview-crontab-content" class="bg-dark text-light p-3 rounded" style="min-height:200px;white-space:pre-wrap;word-break:break-all;font-size:0.875rem;"></pre>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" onclick="copyCrontab()"><i class="bi bi-clipboard"></i> Copy</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- PATCH: edit global env-var lines prepended to the deployed crontab. -->
<div class="modal fade" id="globals-modal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Global Environment Variables</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info mb-3">
          <i class="bi bi-info-circle"></i>
          Lines prepended to every deployed crontab. Use <code>KEY=value</code> format, one per line.
          Setting <code>SHELL=/bin/bash</code> lets cron lines use bash builtins like <code>source</code>.
        </div>
        <textarea id="globals-content" class="form-control font-monospace" rows="8" spellcheck="false" style="white-space:pre;"></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" onclick="saveGlobals();"><i class="bi bi-save"></i> Save &amp; redeploy</button>
      </div>
    </div>
  </div>
</div>
